{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "buildCommand": "export UV_LINK_MODE=copy && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
